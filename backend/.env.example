# LinguaAI FastAPI Backend Configuration
APP_NAME=LinguaAI Backend
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# SQLite database connection string (relative paths resolve inside backend/)
DATABASE_URL=sqlite:///./linguaai.db

# Translation provider configuration
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://libretranslate.com
# Optional API key (required by https://libretranslate.com; leave empty for self-hosted keyless instances)
LIBRETRANSLATE_API_KEY=
REQUEST_TIMEOUT_SECONDS=15.0
